# NewAPI 账号配置示例
# 复制此文件为 .env 并填入实际值（仅用于本地测试）

# ========== 云端配置（推荐）==========
# 优先级高于 NEWAPI_ACCOUNTS，配置文件存放在云盘/NAS，改配置无需推代码
# CONFIG_URL=https://dav.jianguoyun.com/dav/your@email.com/newapi-config.json
# CONFIG_AUTH=your@email.com:your_app_password

# ========== 认证格式说明 ==========
# 坚果云: CONFIG_AUTH=邮箱:应用专用密码（账户设置 → 安全选项 → 第三方应用密码）
# 群晖 NAS: CONFIG_AUTH=用户名:密码（需启用 WebDAV 服务）
# NextCloud: CONFIG_AUTH=用户名:密码 或 CONFIG_AUTH=token:访问令牌
# 直接链接: CONFIG_AUTH=（如果链接无需认证则留空）

# ========== 单账号格式 ==========
NEWAPI_ACCOUNTS=https://your-domain.com#your_session_cookie

# ========== 多网站格式（逗号分隔）==========
# 支持多个不同的 NewAPI 站点
# NEWAPI_ACCOUNTS=https://site1.com#session1,https://site2.com#session2,https://site3.com#session3

# ========== JSON 格式（推荐）==========
# 支持多网站、用户ID、备注名称、更好的可读性
# NEWAPI_ACCOUNTS=[{"url":"https://api.example.com","session":"sess1","user_id":"123","name":"主力站"},{"url":"https://api2.example.com","session":"sess2","user_id":"456","name":"备用站"}]

# ========== JSON 格式 + CF 绕过 ==========
# cf_clearance 可手动提供（可选，Playwright 自动绕过时不需要）
# NEWAPI_ACCOUNTS=[{"url":"https://cf-protected-site.com","session":"sess1","cf_clearance":"cf_clearance_value","name":"CF站点"}]

# ========== 完整示例 ==========
# 替换下面的值为你自己的真实配置
# NEWAPI_ACCOUNTS=[{"url":"https://api.example.com","session":"MTc2NzQxMzYzM3xEWDhFQVFMX2dBQUJFQUVRQUFE...","user_id":"123","name":"主力站"},{"url":"https://api2.example.com","session":"QVFMXzJhYWJFRUFRQUFEX3dfLUFBQVlHYzNSeWFXNW5EQTBBQzI...","user_id":"456","name":"备用站"}]

# ========== 钉钉通知配置 ==========

# 钉钉机器人 Webhook URL（可选，配置后启用通知）
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxxx

# 钉钉机器人签名密钥（可选，如果开启了加签安全设置）
# DINGTALK_SECRET=SECxxxxx

# ========== 邮件通知配置 ==========

# 邮件推送（可选，配置后启用邮件通知）
# EMAIL_SMTP_HOST=smtp.qq.com          # SMTP 服务器地址
# EMAIL_SMTP_PORT=465                   # SMTP 端口 (465 SSL / 587 STARTTLS)
# EMAIL_USER=your@qq.com                # SMTP 登录用户名
# EMAIL_PASS=your_authorization_code    # SMTP 密码/授权码
# EMAIL_TO=receiver@example.com         # 收件人地址
# EMAIL_FROM=your@qq.com                # 发件人地址（可选，默认与 EMAIL_USER 相同）

# ========== ServerChan 通知配置 ==========

# ServerChan 推送（可选，配置后启用微信推送）
# SERVERCHAN_SENDKEY=SCTxxxxx           # ServerChan SendKey (https://sctapi.ftqq.com/SENDKEY.send)

# ========== 通用 Webhook 通知配置 ==========
#
# ⚠️ 安全提示：WEBHOOK_URL 里通常带有推送 token（如 ?usr=xxx、?key=xxx），
#    属于敏感信息。请勿写进代码、README 或 .env.example，只放在：
#      1) GitHub Actions → Settings → Secrets and variables → Actions
#      2) 本地 .env（已被 .gitignore 忽略）
#
# ── 方式一 GET 查询串 ── 消息放在 URL 的 msg 参数里（多数推送网关支持）
# WEBHOOK_URL=http://example.com:88/weixin/?usr=YOUR_TOKEN&from=newapi-checkin&msg=消息
# WEBHOOK_TYPE=query
#    → 实际请求: GET http://example.com:88/weixin/?usr=YOUR_TOKEN&from=newapi-checkin&msg=<报告>
#    注意: 受 URL 长度限制（约 2KB），账号多时报告会被截断

# ── 方式二 POST 表单 ── 长文本不受 URL 长度限制
# WEBHOOK_URL=http://example.com:88/weixin/?usr=YOUR_TOKEN&from=newapi-checkin&msg=消息
# WEBHOOK_TYPE=form
#    → 实际请求: POST http://example.com:88/weixin/
#      body: usr=YOUR_TOKEN&from=newapi-checkin&msg=<签到报告>
# 若不想让 URL 带参数，可改成：
# WEBHOOK_URL=http://example.com:88/weixin
# WEBHOOK_EXTRA=usr=YOUR_TOKEN&from=newapi-checkin
# WEBHOOK_TYPE=form

# ── 方式三 路径占位符 ── 消息替换 URL 路径里的 {消息}（适合 /api/msg/send/TOKEN/{消息} 这类接口）
# WEBHOOK_URL=http://example.com:8765/api/msg/send/YOUR_TOKEN/{消息}
# WEBHOOK_TYPE=path
#    → 实际请求: GET http://example.com:8765/api/msg/send/YOUR_TOKEN/<报告>
#    占位符可用: {消息} {msg} {message} {text} {content}（不带占位符则追加到路径末尾）
#    这类通道通常装不下完整报告，建议配合 WEBHOOK_FORMAT=short

# 正文长度：full=完整报告（默认），short=只发一行摘要（适合 APRS/短信/公众号推送）
# WEBHOOK_FORMAT=short

# WEBHOOK_TOKEN=                         # 仅 telegram 需要：bot token（此时 WEBHOOK_URL 填 chat_id）

# 类型说明:
#   form     POST application/x-www-form-urlencoded（推荐）
#            URL/WEBHOOK_EXTRA 里的固定参数会放进 body，报告写入 msg 参数
#   query    GET，把报告塞进 URL 的 msg 参数（已有 msg= 则替换其值，否则自动追加）
#            URL 带 msg= / text= / message= / content= 参数且未设置 WEBHOOK_TYPE 时自动走这个模式
#   generic  自建服务，POST JSON: {event,title,content,text,execution_time,summary,results}
#   wecom    企业微信群机器人  WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   dingtalk 钉钉机器人        WEBHOOK_URL=https://oapi.dingtalk.com/robot/send?access_token=xxx
#   feishu   飞书自定义机器人  WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/xxx
#   bark     iOS Bark 推送     WEBHOOK_URL=https://api.day.app/你的KEY
#   telegram Telegram Bot      WEBHOOK_URL=chat_id + WEBHOOK_TOKEN=bot_token

# 仅失败时推送（对所有通知渠道生效）
# NOTIFY_ONLY_FAILURE=1

# ========== Cloudflare 绕过说明 ==========
# 本项目支持自动绕过 Cloudflare 防护：
# - 默认使用 requests 直连（快速模式）
# - 检测到 CF 拦截时自动切换 Playwright 无头浏览器
# - GitHub Actions 已配置 Playwright 安装步骤
# - 本地运行需手动安装: pip install playwright && playwright install chromium
# - cf_clearance 字段仍可手动配置作为备用
